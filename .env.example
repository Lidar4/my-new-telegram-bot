# ==============================================================================
# Telegram Bot Configuration Template
# DO NOT put your real token in this file or commit it to GitHub.
# Copy this file to '.env' on your local machine / server and fill in the values.
# ==============================================================================

# Telegram Bot Token from @BotFather (Example format: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Environment Mode: 'development' or 'production'
NODE_ENV="development"

